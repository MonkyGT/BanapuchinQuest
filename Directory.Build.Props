<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <PropertyGroup>
        <ExportPath>$(UserProfile)\Documents\CapuchinMods\</ExportPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(CI)'=='TRUE'">
        <GameAssemblyPath>.\Libs</GameAssemblyPath>
        <MelonLoaderAssemblyPath>.\Libs</MelonLoaderAssemblyPath>
        <ModsPath>.\Libs</ModsPath>
        <WarningLevel>0</WarningLevel>
    </PropertyGroup>
</Project>